# Copy to `.env` (`cp .env.example .env`). `.env` is gitignored.
# Loaded from the process current working directory (usually the repo root when you run
# `python -m src`). Values apply to pydantic-settings env vars; they override YAML for the same keys.

# --- Web Search (Required for Librarian Research) ---
# Get a free key at: https://api.search.brave.com/app/dashboard (2k/mo)
LIBRARIAN_WEB_SEARCH_PROVIDER=brave
LIBRARIAN_WEB_SEARCH_API_KEY=

# OR Tavily (1k/mo): https://tavily.com/
# LIBRARIAN_WEB_SEARCH_PROVIDER=tavily
# LIBRARIAN_WEB_SEARCH_API_KEY=

# OR Serper (2.5k/mo): https://serper.dev/
# LIBRARIAN_WEB_SEARCH_PROVIDER=serper
# LIBRARIAN_WEB_SEARCH_API_KEY=

# --- Inference & Embedding ---
# Provider options: "auto", "sentence-transformers", "ollama", or "dummy"
LIBRARIAN_EMBEDDING_PROVIDER=ollama
LIBRARIAN_EMBEDDING_OLLAMA_URL=http://localhost:11434
LIBRARIAN_EMBEDDING_MODEL_NAME=nomic-embed-text

# Verification settings
LIBRARIAN_VERIFICATION_ENABLED=true
LIBRARIAN_VERIFICATION_CLAIM_MODEL=llama3.2
LIBRARIAN_VERIFICATION_OLLAMA_BASE_URL=http://localhost:11434

# --- Local MongoDB (`docker compose up -d mongo`) ---
# `directConnection=true` avoids replica-set discovery issues with the Atlas Local image from the host.
LIBRARIAN_DATABASE_URI=mongodb://127.0.0.1:27017/?directConnection=true
LIBRARIAN_DATABASE_TLS=false
# Empty is OK when TLS is false. If `LIBRARIAN_DATABASE_TLS=true`, set one real file path (no globs).
LIBRARIAN_DATABASE_TLS_CERT_PATH=

# --- MongoDB Atlas (uncomment and fill) ---
# LIBRARIAN_DATABASE_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# LIBRARIAN_DATABASE_TLS=true
# LIBRARIAN_DATABASE_TLS_CERT_PATH=/path/to/your-atlas-cert.pem
